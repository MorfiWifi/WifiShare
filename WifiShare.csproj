<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Thin build wrapper. ALL application code lives in Program.cs (single file).
    - dotnet run                       (from an elevated Windows terminal)
    - dotnet publish -c Release -r win-x64 [self-contained single file, see README in Program.cs]
    - Or, with only the .cs file: dotnet run Program.cs (.NET 10 file-based apps)
    EnableWindowsTargeting lets this Windows-targeted project also compile
    on non-Windows machines for syntax checking (it will refuse sharing at runtime).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WifiShare</AssemblyName>
    <RootNamespace>WifiShare</RootNamespace>
    <!-- Base version for autoversioning. Local builds use this as-is (1.1.2).
         CI appends the GitHub run number on the `release` branch:
           dotnet publish /p:Version=$(VersionPrefix).<run_number>
         so every release build gets a unique version (e.g. 1.1.2.78) and the
         GitHub Release is tagged v<that version>. Bump VersionPrefix here to
         start a new series. No NuGet versioning packages required. -->
    <VersionPrefix>1.1.2</VersionPrefix>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Description>Share laptop Wi-Fi over Ethernet with a dedicated client subnet, NAT, DHCP and file sharing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="WifiShare.Tests" />
  </ItemGroup>

</Project>
